<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme tokens. ThemeService overrides these keys with system brushes in Windows high contrast. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#121212" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#252525" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="LineBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2F2F35" />
    <SolidColorBrush x:Key="PressedBrush" Color="#38383F" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#1E3A5F" />
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#7A7A80" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#191919" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
</ResourceDictionary>
