<Window x:Class="restByAno.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="restByAno — Settings" Width="680" Height="720" MinWidth="560" MinHeight="480"
        ShowInTaskbar="False" Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="22,18,22,8">
                <TextBlock Text="Limits" FontSize="16" FontWeight="SemiBold" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Request timeout (seconds)" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox Grid.Column="1" Margin="0,0,0,8" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Request timeout seconds" />
                    <TextBlock Grid.Column="2" Text="1 – 600" Margin="10,0,0,8" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Grid.Row="1" Text="Response size limit (KiB)" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ResponseLimitKiB, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Response size limit KiB" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="1 – 102,400 (default 10,240 = 10 MiB, decoded size)" Margin="10,0,0,8"
                               VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Grid.Row="2" Text="History retention (days)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="History retention days" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="1 – 3650" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </Grid>

                <TextBlock Text="Transport of the active environment" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,0" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                           x:Name="TransportHint" />
                <StackPanel x:Name="TransportPanel" Margin="0,10,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActiveEnvironment}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Proxy" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding ProxyModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding ProxyMode}" MaxWidth="320" HorizontalAlignment="Left" Width="320"
                              AutomationProperties.Name="Proxy mode" />
                    <TextBlock Text="Proxy address (explicit mode)" Margin="0,10,0,4" />
                    <TextBox Text="{Binding ProxyUri, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsExplicitProxy}"
                             AutomationProperties.Name="Proxy address" />
                    <CheckBox Content="Allow plain HTTP to non-loopback hosts" Margin="0,12,0,0"
                              IsChecked="{Binding AllowNonLoopbackHttp}" AutomationProperties.Name="Allow non-loopback HTTP"
                              ToolTip="Also requires the host to be listed in the managed target policy" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="If a configured proxy fails, the request fails; restByAno never retries without the proxy. Redirects, cookies and automatic retries are always off." />
                </StackPanel>

                <TextBlock Text="Destination policy" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,0" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding PolicySummary}" x:Name="PolicySummaryText" />
                <ItemsControl ItemsSource="{Binding PolicyTargets}" Margin="12,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="Policy file (read-only for restByAno): " /><Run Text="{Binding PolicyPath, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="This guard limits where restByAno sends requests. It does not replace corporate firewall or proxy controls." />

                <TextBlock Text="Data folder" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,0" />
                <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,0" AutomationProperties.Name="Data folder" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding DataDirectoryHelp}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="22,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource PanelBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SettingsValidationText" Text="{Binding ValidationText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorBrush}" />
                    <TextBlock x:Name="SettingsSavedText" Text="{Binding SavedText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SuccessBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}"
                            AutomationProperties.Name="Save settings" />
                    <Button Content="Close" Margin="8,0,0,0" IsCancel="True" AutomationProperties.Name="Close settings" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
