<UserControl x:Class="restByAno.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:restByAno.Desktop.ViewModels">
    <UserControl.Resources>
        <Style x:Key="ToneText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Info}">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Run history" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="HistoryStatus" Text="{Binding StatusText}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="640" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding RetentionText}" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,0" AutomationProperties.Name="Refresh history" />
                        <Button Content="Export report…" Command="{Binding ExportReportCommand}" Margin="0,0,6,0"
                                AutomationProperties.Name="Export run report" ToolTip="Save the selected run as a JSON report (metadata only)" />
                        <Button Content="Clear history…" Command="{Binding ClearHistoryCommand}" AutomationProperties.Name="Clear history"
                                ToolTip="Delete saved run history (collections are not affected)" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" MinWidth="240" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Past runs">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Started}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Started}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding OutcomeText}" Style="{StaticResource ToneText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding CollectionName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No runs saved yet." Margin="14,12" VerticalAlignment="Top" IsHitTestVisible="False"
                               Foreground="{DynamicResource SecondaryTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" AutomationProperties.Name="Resize history list" />
                <ListBox Grid.Column="2" ItemsSource="{Binding Steps}" AutomationProperties.Name="History steps" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource ToneText}" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding Sequence}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" MinWidth="180" MaxWidth="320" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="3" Text="{Binding OutcomeText}" Style="{StaticResource ToneText}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Margin="0,0,10,0" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Text="{Binding KindLabel}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}">
                                    <Run Text="{Binding Detail, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Message, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</UserControl>
