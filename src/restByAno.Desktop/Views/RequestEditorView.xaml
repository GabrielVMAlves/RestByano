<UserControl x:Class="restByAno.Desktop.Views.RequestEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:restByAno.Desktop.Views"
             xmlns:vm="clr-namespace:restByAno.Desktop.ViewModels"
             xmlns:core="clr-namespace:restByAno.Core.Models;assembly=restByAno.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Request identity: name, cleanup flag, save, saved/unsaved state -->
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Request name" />
                <CheckBox Grid.Column="2" Content="Cleanup request" Margin="14,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding IsCleanup}" AutomationProperties.Name="Cleanup request"
                          ToolTip="Runs once at the end of a collection run, even after failures" />
                <Button Grid.Column="3" Content="Save" Margin="12,0,0,0" Command="{Binding SaveCommand}"
                        Style="{StaticResource AccentButton}" AutomationProperties.Name="Save request"
                        ToolTip="Save this request (Ctrl+S)" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="LocationLabel" Text="{Binding LocationText}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock x:Name="RequestStateLabel" Text="{Binding StateText}" Margin="14,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    <TabControl Grid.Row="1" AutomationProperties.Name="Request editor">
        <TabItem Header="Parameters">
            <views:KeyValueEditorView DataContext="{Binding Parameters}" />
        </TabItem>
        <TabItem Header="Headers">
            <views:KeyValueEditorView DataContext="{Binding Headers}" />
        </TabItem>
        <TabItem Header="Body">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Body type" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox Width="140" ItemsSource="{Binding BodyKindOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding BodyKind}"
                              AutomationProperties.Name="Body type" />
                    <Button Content="Format JSON" Margin="12,0,0,0" Command="{Binding FormatJsonCommand}"
                            AutomationProperties.Name="Format JSON" ToolTip="Indent the JSON body">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BodyKind}" Value="{x:Static core:BodyKind.Json}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding BodyMessage}" Margin="0,0,0,8" TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BodyMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox Grid.Row="2" Text="{Binding BodyText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalContentAlignment="Top" FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Request body">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BodyKind}" Value="{x:Static core:BodyKind.None}">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </TabItem>
        <TabItem Header="Authentication">
            <StackPanel Margin="12" MaxWidth="460" HorizontalAlignment="Left">
                <TextBlock Text="Type" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                <ComboBox ItemsSource="{Binding AuthKindOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding AuthKind}" AutomationProperties.Name="Authentication type" />
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Enter the name of a variable, not the credential itself. Create that variable as a secret in the selected environment (Manage…); it is stored encrypted and masked." />

                <StackPanel Margin="0,10,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AuthKind}" Value="{x:Static core:AuthKind.Bearer}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Token variable" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding TokenVariable, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Token variable" />
                    <TextBlock Text="Sent as: Authorization: Bearer &lt;value&gt;" Margin="0,4,0,0" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AuthKind}" Value="{x:Static core:AuthKind.Basic}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="User name variable" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding UsernameVariable, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="User name variable" />
                    <TextBlock Text="Password variable" Margin="0,10,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding PasswordVariable, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Password variable" />
                    <TextBlock Text="Sent as: Authorization: Basic base64(user:password)" Margin="0,4,0,0" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AuthKind}" Value="{x:Static core:AuthKind.ApiKey}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Key name (header or query parameter name)" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding ApiKeyName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="API key name" />
                    <TextBlock Text="Key variable" Margin="0,10,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding ApiKeyVariable, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="API key variable" />
                    <TextBlock Text="Send in" Margin="0,10,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox ItemsSource="{Binding ApiKeyLocationOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding ApiKeyIn}" AutomationProperties.Name="API key location" />
                </StackPanel>
            </StackPanel>
        </TabItem>        <TabItem Header="Assertions">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" DataContext="{Binding Assertions}">
                    <Button Content="＋ Add assertion" Command="{Binding AddCommand}" AutomationProperties.Name="Add assertion" />
                    <TextBlock Text="All assertions must pass. A request without assertions only checks that it completed."
                               Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              DataContext="{Binding Assertions}">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" KeyboardNavigation.TabNavigation="Continue">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="10" Background="{DynamicResource RaisedBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Width="180" VerticalAlignment="Top" ItemsSource="{Binding DataContext.KindOptions, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kind}"
                                                      AutomationProperties.Name="Assertion type" />
                                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                                <TextBox Margin="0,0,0,6" Text="{Binding StatusText, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Expected status code"
                                                         Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBox Margin="0,0,0,6" Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Header name" ToolTip="Header name (case-insensitive)"
                                                         Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBox Margin="0,0,0,6" Text="{Binding JsonPointer, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="JSON pointer" ToolTip="JSON pointer, e.g. /data/id"
                                                         Visibility="{Binding ShowPointer, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBox Margin="0,0,0,6" Text="{Binding ExpectedText, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Expected value"
                                                         Visibility="{Binding ShowExpected, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBox Margin="0,0,0,6" Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Time limit milliseconds"
                                                         Visibility="{Binding ShowDuration, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource ErrorBrush}"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Content="▲" Padding="0" MinWidth="28" Margin="0,0,4,0" AutomationProperties.Name="Move assertion up"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}" />
                                                <Button Content="▼" Padding="0" MinWidth="28" Margin="0,0,4,0" AutomationProperties.Name="Move assertion down"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}" />
                                                <Button Content="✕" Padding="0" MinWidth="28" AutomationProperties.Name="Remove assertion"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No assertions" Margin="4,4,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem Header="Extraction">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" DataContext="{Binding Extractors}">
                    <Button Content="＋ Add extractor" Command="{Binding AddCommand}" AutomationProperties.Name="Add extractor" />
                    <TextBlock Text="Runs after all assertions pass. Values are masked and live only for the collection run. Objects and lists cannot be extracted."
                               Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              DataContext="{Binding Extractors}">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" KeyboardNavigation.TabNavigation="Continue">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="10" Background="{DynamicResource RaisedBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="JSON pointer" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding JsonPointer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Extractor JSON pointer" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Bottom" Margin="10,0,10,5" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Variable name" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Extractor variable name" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                                                <Button Content="▲" Padding="0" MinWidth="28" Margin="0,0,4,0" AutomationProperties.Name="Move extractor up"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}" />
                                                <Button Content="▼" Padding="0" MinWidth="28" Margin="0,0,4,0" AutomationProperties.Name="Move extractor down"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}" />
                                                <Button Content="✕" Padding="0" MinWidth="28" AutomationProperties.Name="Remove extractor"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource ErrorBrush}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No extraction rules" Margin="4,4,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </TabItem>    </TabControl>
    </Grid>
</UserControl>
