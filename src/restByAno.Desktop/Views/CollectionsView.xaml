<UserControl x:Class="restByAno.Desktop.Views.CollectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:restByAno.Desktop.ViewModels">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:CollectionNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Title}" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:RequestNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StateMark}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,4,0" />
                <TextBlock Text="{Binding MethodLabel}" FontSize="10" FontWeight="SemiBold" Margin="0,0,6,0"
                           VerticalAlignment="Center" Opacity="0.75" />
                <TextBlock Text="{Binding Title}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,0,1" Padding="12,9">
                <TextBlock Text="Collections" FontWeight="SemiBold" />
            </Border>

            <WrapPanel Grid.Row="1" Margin="6,6,6,2">
                <Button Content="＋ Collection" Command="{Binding NewCollectionCommand}" Style="{StaticResource CompactButton}"
                        AutomationProperties.Name="New collection" ToolTip="Create an empty collection" />
                <Button Content="＋ Folder" Command="{Binding NewFolderCommand}" Style="{StaticResource CompactButton}"
                        AutomationProperties.Name="New folder" ToolTip="Create a folder in the selected collection" />
                <Button Content="＋ Request" Command="{Binding NewRequestCommand}" Style="{StaticResource CompactButton}"
                        AutomationProperties.Name="New request" ToolTip="Create a request (unsaved until you save it)" />
                <Button Content="Import…" Command="{Binding ImportCollectionCommand}" Style="{StaticResource CompactButton}"
                        AutomationProperties.Name="Import collection" ToolTip="Import a collection file as a new collection" />
                <Button Content="Export…" Command="{Binding ExportCollectionCommand}" Style="{StaticResource CompactButton}"
                        AutomationProperties.Name="Export collection" ToolTip="Export the selected collection (no secrets, no history)" />
                <Button Content="Variables…" Command="{Binding EditVariablesCommand}" Style="{StaticResource CompactButton}"
                        AutomationProperties.Name="Collection variables" ToolTip="Edit the default variables of the selected collection" />
                <Button Content="Rename" Command="{Binding RenameCommand}" Style="{StaticResource CompactButton}"
                        AutomationProperties.Name="Rename" ToolTip="Rename the selected item (F2)" />
                <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Style="{StaticResource CompactButton}"
                        AutomationProperties.Name="Duplicate" ToolTip="Copy the selected item with new ids" />
                <Button Content="▲ Up" Command="{Binding MoveUpCommand}" Style="{StaticResource CompactButton}"
                        AutomationProperties.Name="Move up" ToolTip="Move up (earlier in the run order)" />
                <Button Content="▼ Down" Command="{Binding MoveDownCommand}" Style="{StaticResource CompactButton}"
                        AutomationProperties.Name="Move down" ToolTip="Move down (later in the run order)" />
                <Button Content="Move to…" Command="{Binding MoveToCommand}" Style="{StaticResource CompactButton}"
                        AutomationProperties.Name="Move to" ToolTip="Move the request to another folder or the root" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource CompactButton}"
                        AutomationProperties.Name="Delete" ToolTip="Delete the selected item (Del)" />
            </WrapPanel>

            <Grid Grid.Row="2">
                <TreeView ItemsSource="{Binding Collections}" AutomationProperties.Name="Collections">
                    <TreeView.InputBindings>
                        <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                    </TreeView.InputBindings>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
                <TextBlock Text="No collections yet. Use ＋ Collection to create one." Margin="14,12" TextWrapping="Wrap"
                           VerticalAlignment="Top" IsHitTestVisible="False" Foreground="{DynamicResource SecondaryTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoCollections}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,6">
                <TextBlock x:Name="CollectionStatus" Text="{Binding StatusText}" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
