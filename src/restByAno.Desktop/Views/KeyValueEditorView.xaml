<UserControl x:Class="restByAno.Desktop.Views.KeyValueEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="＋ Add" Command="{Binding AddCommand}"
                    AutomationProperties.Name="Add row" ToolTip="Add a row" />
            <TextBlock Text="Duplicate names are allowed and sent in order. Unchecked rows are ignored."
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>

        <!-- Column header -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="On" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Margin="4,0,0,0" />
            <TextBlock Grid.Column="2" Text="Value" FontWeight="SemiBold" Margin="4,0,0,0" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Grid>
                <ItemsControl ItemsSource="{Binding Rows}" KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Padding="0"
                                          AutomationProperties.Name="Enabled" ToolTip="Send this row" />
                                <TextBox Grid.Column="1" Margin="4,0,0,0"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Name" />
                                <TextBox Grid.Column="2" Margin="6,0,0,0"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Value" />
                                <Button Grid.Column="3" Content="✕" Margin="6,0,0,0" Padding="0" MinWidth="32"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Remove row" ToolTip="Remove this row" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No rows. Use Add to create one." Margin="4,4,0,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
