<UserControl x:Class="restByAno.Desktop.Views.ResponseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:restByAno.Desktop.ViewModels">
    <UserControl.Resources>
        <Style x:Key="ToneText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Info}">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status line: glyph + text (never color alone) -->
        <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Response" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusGlyphText" Text="{Binding StatusGlyph}" Style="{StaticResource ToneText}" Margin="0,0,5,0" />
                    <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Style="{StaticResource ToneText}" FontWeight="SemiBold" />
                    <TextBlock x:Name="MetricsText" Text="{Binding MetricsText}" Margin="14,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock x:Name="ChecksSummary" Text="{Binding ChecksText}" Margin="14,0,0,0" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChecksTone}" Value="{x:Static vm:StatusTone.Success}">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChecksTone}" Value="{x:Static vm:StatusTone.Error}">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Load full body" Command="{Binding LoadFullBodyCommand}" Margin="0,0,6,0"
                            Visibility="{Binding CanLoadFullBody, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Load full body" ToolTip="Load the rest of this large response into the viewer" />
                    <Button Content="Save body…" Command="{Binding SaveBodyCommand}" Margin="0,0,6,0"
                            Visibility="{Binding CanSaveBody, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Save body to file" ToolTip="Write the complete response body to a file" />
                    <Button Content="Copy body" Command="{Binding CopyBodyCommand}" Margin="0,0,6,0"
                            AutomationProperties.Name="Copy body" ToolTip="Copy the response body shown here to the clipboard" />
                    <Button Content="Clear" Command="{Binding ClearResponseCommand}"
                            AutomationProperties.Name="Clear response" ToolTip="Discard the displayed response" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Banner: errors, warnings and notes -->
        <Border Grid.Row="1" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="12,6"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding BannerGlyph}" Style="{StaticResource ToneText}" Margin="0,0,8,0" />
                <TextBlock x:Name="BannerText" Text="{Binding BannerText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" AutomationProperties.Name="Response body and headers">
            <TabItem Header="Pretty">
                <TextBox Text="{Binding PrettyText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         BorderThickness="0" FontFamily="Consolas" VerticalContentAlignment="Top"
                         Background="{DynamicResource PanelBrush}" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Pretty response body" />
            </TabItem>
            <TabItem Header="Raw">
                <TextBox Text="{Binding RawText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         BorderThickness="0" FontFamily="Consolas" VerticalContentAlignment="Top"
                         Background="{DynamicResource PanelBrush}" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Raw response body" />
            </TabItem>
            <TabItem Header="Checks">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Checks}" Margin="12" AutomationProperties.Name="Check results">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Glyph}" Width="20" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Success}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Error}">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxWidth="900" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontFamily="Consolas" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Headers">
                <DataGrid ItemsSource="{Binding Headers}" IsReadOnly="True" BorderThickness="0"
                          AutomationProperties.Name="Response headers">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="220" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=OneWay}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Empty state: app icon + name until a response arrives -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <Image Source="pack://application:,,,/Assets/favicon-180x180.png" Width="96" Height="96" Opacity="0.85"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="RestByAno" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</UserControl>

