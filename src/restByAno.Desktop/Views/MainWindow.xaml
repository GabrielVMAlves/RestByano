<Window x:Class="restByAno.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:restByAno.Desktop.Views"
        Title="restByAno" Height="800" Width="1280" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindowStyle}">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnCloseExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding RequestEditor.SaveCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding ShowSettingsCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="5" />
            <RowDefinition Height="230" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings…" Command="{Binding ShowSettingsCommand}" InputGestureText="Ctrl+," />
                <MenuItem Header="E_xit" Command="ApplicationCommands.Close" InputGestureText="Alt+F4" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Environment" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ActiveEnvironment.Options}"
                          SelectedItem="{Binding ActiveEnvironment.Selected}" DisplayMemberPath="Name"
                          AutomationProperties.Name="Environment" ToolTip="Active environment">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Button Grid.Column="2" Content="Manage…" Margin="6,0,0,0" Command="{Binding ManageEnvironmentsCommand}"
                        AutomationProperties.Name="Manage environments" ToolTip="Create environments and edit their variables" />
                <ComboBox Grid.Column="3" Width="110" Margin="12,0,6,0" ItemsSource="{Binding RequestEditor.MethodOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding RequestEditor.Method}"
                          AutomationProperties.Name="HTTP method" ToolTip="HTTP method" />
                <TextBox Grid.Column="4" Text="{Binding RequestEditor.Url, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Request URL" ToolTip="Request URL, e.g. http://127.0.0.1:5000/health">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding RequestEditor.SendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="5" Content="▶ Send" Margin="10,0,6,0" Style="{StaticResource AccentButton}"
                        Command="{Binding RequestEditor.SendCommand}" AutomationProperties.Name="Send"
                        ToolTip="Send the request (Enter in the URL box)" />
                <Button Grid.Column="6" Content="■ Cancel" Command="{Binding RequestEditor.CancelCommand}"
                        AutomationProperties.Name="Cancel" ToolTip="Cancel the request in flight" />
            </Grid>
        </Border>

        <!-- Main area: collections | editor + response -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" MaxWidth="520" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Collections pane -->
            <views:CollectionsView DataContext="{Binding CollectionTree}" />

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" AutomationProperties.Name="Resize collections pane" />

            <!-- Editor and response -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="130" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" MinHeight="110" />
                </Grid.RowDefinitions>

                <views:RequestEditorView DataContext="{Binding RequestEditor}" />

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Rows" AutomationProperties.Name="Resize response pane" />

                <views:ResponseView Grid.Row="2" DataContext="{Binding Response}" />
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" AutomationProperties.Name="Resize runner pane" />

        <!-- Runner -->
        <TabControl Grid.Row="4" AutomationProperties.Name="Runner and history">
            <TabItem Header="Runner">
                <views:RunnerView DataContext="{Binding Runner}" />
            </TabItem>
            <TabItem Header="History">
                <views:HistoryView DataContext="{Binding History}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>

