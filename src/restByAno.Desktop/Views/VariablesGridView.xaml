<UserControl x:Class="restByAno.Desktop.Views.VariablesGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:restByAno.Desktop.Services">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="＋ Add variable" Command="{Binding AddCommand}" AutomationProperties.Name="Add variable" />
            <TextBlock Text="Reference a variable as {{name}}. Names are case-sensitive." Margin="12,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Name" FontWeight="SemiBold" Margin="4,0,0,0" />
            <TextBlock Grid.Column="1" Text="Secret" FontWeight="SemiBold" Margin="10,0,10,0"
                       Visibility="{Binding AllowSecrets, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Column="2" Text="Value" FontWeight="SemiBold" Margin="4,0,0,0" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
                <ItemsControl ItemsSource="{Binding Rows}" KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Margin="4,0,0,0" VerticalAlignment="Top" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Variable name" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSecret}" Margin="10,6,10,0" VerticalAlignment="Top"
                                          AutomationProperties.Name="Secret" ToolTip="Store this value encrypted for this Windows user and mask it"
                                          Visibility="{Binding DataContext.AllowSecrets, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Variable value">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSecret}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <PasswordBox svc:PasswordBoxBinder.BoundPassword="{Binding NewSecretValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Secret value">
                                        <PasswordBox.Style>
                                            <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSecret}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </PasswordBox.Style>
                                    </PasswordBox>
                                    <TextBlock Text="{Binding SecretHint}" FontSize="11" Margin="2,2,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSecret}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="3" Content="✕" Margin="6,0,0,0" Padding="0" MinWidth="32" VerticalAlignment="Top"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="Remove variable"
                                        ToolTip="Remove this variable" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No variables. Use Add variable to create one." Margin="4,4,0,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
