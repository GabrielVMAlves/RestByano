<Window x:Class="restByAno.Desktop.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="restByAno" Width="540" SizeToContent="Height" MaxHeight="640"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">
    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" />
        <TextBox x:Name="DetailText" Grid.Row="2" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap"
                 FontFamily="Consolas" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Details" Visibility="Collapsed" />
        <TextBox x:Name="InputBox" Grid.Row="3" Margin="0,14,0,0" AutomationProperties.Name="Value"
                 Visibility="Collapsed" />
        <ListBox x:Name="ChoiceList" Grid.Row="4" Margin="0,14,0,0" MaxHeight="220"
                 BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                 AutomationProperties.Name="Choices" Visibility="Collapsed" />
        <StackPanel x:Name="ButtonPanel" Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,0" />
    </Grid>
</Window>
